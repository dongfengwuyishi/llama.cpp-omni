{
    "backend": "cpp",

    "model": {
        "model_path": "unused-for-cpp-backend",
        "pt_path": null,
        "attn_implementation": "auto"
    },

    "cpp_backend": {
        "_comment": "Required when backend=cpp. Point llamacpp_root at this repo root.",
        "llamacpp_root": "/abs/path/to/llama.cpp-omni",
        "model_dir":     "/abs/path/to/MiniCPM-o-4_5-gguf",
        "llm_model":     "MiniCPM-o-4_5-Q8_0.gguf",
        "cpp_server_port": null,
        "ctx_size": 32768,
        "n_gpu_layers": 99
    },

    "audio": {
        "ref_audio_path": "assets/ref_audio/ref_minicpm_signature.wav",
        "playback_delay_ms": 200,
        "chat_vocoder": "token2wav"
    },

    "service": {
        "gateway_port": 8080,
        "worker_base_port": 22440,
        "num_workers": 1,
        "max_queue_size": 1000,
        "request_timeout": 600.0,
        "eta_chat_s": 15.0,
        "eta_audio_duplex_s": 120.0,
        "eta_omni_duplex_s": 90.0,
        "eta_duplex_s": 120.0,
        "eta_ema_alpha": 0.3,
        "eta_ema_min_samples": 3,
        "data_dir": "data"
    },

    "duplex": {
        "pause_timeout": 60.0
    },

    "recording": {
        "_comment": "Disable session recording entirely for batch / eval workloads.",
        "enabled": false,
        "session_retention_days": -1,
        "max_storage_gb": -1
    }
}
